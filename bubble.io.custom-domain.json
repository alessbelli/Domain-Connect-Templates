{
	"providerId": "bubble.io",
	"providerName": "Bubble",
	"serviceId": "custom-domain",
	"serviceName": "Custom domain",
	"version": 1,
	"syncPubKeyDomain": "bubble.io",
	"hostRequired": true,
	"description": "Point a domain or subdomain at a Bubble app.",
	"logoUrl": "https://meta-q.cdn.bubble.io/f1756386552835x162920220128838430/Logo%20%281%29.svg",
	"records": [
		{
			"groupId": "domain",
			"type": "CNAME",
			"host": "@",
			"pointsTo": "app.bubble.io",
			"ttl": 3600
		},
		{
			"groupId": "www",
			"type": "CNAME",
			"host": "www",
			"pointsTo": "app.bubble.io",
			"ttl": 3600
		},
		{
			"groupId": "verify",
			"type": "TXT",
			"host": "_cf-custom-hostname",
			"data": "%cfToken%",
			"ttl": 3600,
			"txtConflictMatchingMode": "All"
		}
	],
	"variableDescription": "cfToken is the custom hostname ownership token Cloudflare issues for the domain; Cloudflare compares the TXT value exactly, so it cannot carry a prefix."
}
